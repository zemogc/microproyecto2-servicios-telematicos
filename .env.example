# Copia este archivo a .env y cambia los valores antes de desplegar.

# Base de datos
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DB=opscenter
MYSQL_USER=opscenter
MYSQL_PASSWORD=change-me

# Aplicación
SECRET_KEY=change-me-in-production
SEED_DEMO_DATA=true

# Hosts incluidos en el certificado autofirmado (separados por coma)
CERT_HOSTS=localhost,127.0.0.1,192.168.50.3

# URLs públicas que la interfaz enlaza
GRAFANA_PUBLIC_URL=http://localhost:3000
PROMETHEUS_PUBLIC_URL=http://localhost:9090

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Copiloto IA (opcional). Sin clave se usa el motor de reglas local.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
