# Copia este archivo a .env solo si quieres personalizar algo: todo es opcional.
#
# Las contraseñas NO tienen valor por defecto. Si las dejas vacías, el primer
# `docker compose up` las genera al azar en ./secrets/ (ignorado por git):
#   secrets/admin_password          -> cuenta "admin" de OpsCenter
#   secrets/grafana_admin_password  -> usuario "admin" de Grafana
# Si defines un valor aquí, se usa ese en lugar de uno aleatorio (solo la primera vez).

# Base de datos
MYSQL_DB=opscenter
MYSQL_USER=opscenter
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Aplicación
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SEED_DEMO_DATA=true

# Hosts incluidos en el certificado autofirmado (separados por coma)
CERT_HOSTS=localhost,127.0.0.1,192.168.50.3

# Grafana y Prometheus no tienen login propio de la app: por defecto solo
# escuchan en 127.0.0.1. Usa 0.0.0.0 únicamente en una red privada (Vagrant).
MONITORING_BIND=127.0.0.1
GRAFANA_PUBLIC_URL=http://localhost:3000
PROMETHEUS_PUBLIC_URL=http://localhost:9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Copiloto IA (opcional). Sin clave se usa el motor de reglas local.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
